# =====================================================
# VC Africa Networks - Git Ignore
# =====================================================

# -----------------------
# Proprietary Data (ATBD)
# -----------------------
# Raw purchased data - DO NOT COMMIT
data/raw/
data/raw/*.xlsx
data/raw/*.csv

# Processed data with investor identities
data/processed/
data/processed/*.parquet
data/processed/*.csv

# Any data backups
data/*.bak
data/*.backup

# Interim data
data/interim/*
!data/interim/.gitkeep

# -----------------------
# Python
# -----------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
venv/
ENV/
env/
.venv/
.env
*.env

# -----------------------
# Jupyter Notebooks
# -----------------------
.ipynb_checkpoints/
*.ipynb_checkpoints

# -----------------------
# IDE / Editor
# -----------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -----------------------
# Testing
# -----------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# -----------------------
# Logs
# -----------------------
*.log
logs/*
!logs/.gitkeep

# -----------------------
# Secrets / Credentials
# -----------------------
*.pem
*.key
credentials.json
secrets.yaml

# -----------------------
# Large files
# -----------------------
*.zip
*.tar.gz
*.rar
